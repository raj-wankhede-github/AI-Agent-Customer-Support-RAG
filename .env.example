# Copy to .env and adjust. Never commit .env.
# Every variable maps to a field in backend/app/core/config.py (case-insensitive).

# --- Application ------------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
LOG_JSON=false                      # true in production (structured JSON logs)
EXPOSE_API_DOCS=true                # Swagger UI at /docs
TRUST_PROXY_HEADERS=false           # true only behind a trusted load balancer

# --- Database (docker compose builds DATABASE_URL from these) ---------------
POSTGRES_USER=support
POSTGRES_PASSWORD=support           # local only - use a managed secret in production
POSTGRES_DB=support
POSTGRES_HOST_PORT=5432
# Used when running the backend directly on the host (outside compose):
DATABASE_URL=postgresql+asyncpg://support:support@localhost:5432/support
# Used by the integration/E2E test suite (created by deploy/postgres/init):
TEST_DATABASE_URL=postgresql+asyncpg://support:support@localhost:5432/support_test

# --- Auth -------------------------------------------------------------------
# REQUIRED. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
JWT_EXPIRES_MINUTES=480
AUTH_COOKIE_SECURE=false            # must be true in production (HTTPS)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8080

# --- LLM ----------------------------------------------------------------------
# none      = offline mode: rule-based query understanding + extractive answers (no API key)
# anthropic = Claude via the official SDK (default model claude-opus-5)
# openai    = OpenAI Chat Completions with JSON-schema structured output
LLM_PROVIDER=none
LLM_MODEL=
LLM_TEMPERATURE=0                   # ignored by Anthropic models that reject sampling params
LLM_MAX_TOKENS=8000
LLM_MAX_INPUT_TOKENS=12000
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_EFFORT=medium                   # Anthropic effort: low | medium | high
ANTHROPIC_API_KEY=
ANTHROPIC_REFUSAL_FALLBACK=true
OPENAI_API_KEY=

# --- Embeddings ---------------------------------------------------------------
# hashing = offline deterministic embedder (lexical). openai / bedrock for semantic search.
# Changing provider/model/dimension requires: python -m app.cli reindex-all
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=hashing-v1          # e.g. text-embedding-3-small | amazon.titan-embed-text-v2:0
VECTOR_DIMENSION=384                # e.g. 1536 for text-embedding-3-small, 1024 for Titan v2
AWS_REGION=us-east-1

# --- Retrieval / grounding (see docs/rag.md for reasoning) --------------------
RAG_TOP_K=20
RAG_MIN_SCORE=0.15
RAG_MIN_RERANK_SCORE=0.35
RAG_MAX_CONTEXT=5
RAG_MIN_QUERY_COVERAGE=0.6
# RAG_SEMANTIC_OVERRIDE_SIMILARITY=0.6   # only with a semantic embedding provider
RERANKER_ENABLED=true
RERANKER_PROVIDER=heuristic         # heuristic | llm
SOURCE_AUTHORITY_RANKING=OFFICIAL_POLICY:100,OFFICIAL_DOCUMENTATION:90,PRODUCT_DOCUMENTATION:80,FAQ:60,SUPPORT_ARTICLE:50,INTERNAL_GUIDE:40,LOW_PRIORITY:10
GROUNDING_MIN_CLAIM_SUPPORT=0.6
CONFIDENCE_HIGH_THRESHOLD=0.75
CONFIDENCE_MEDIUM_THRESHOLD=0.55

# --- Conversations / handoff / privacy ----------------------------------------
CONVERSATION_HISTORY_MESSAGES=6
HANDOFF_FAILED_ANSWERS_THRESHOLD=2
HANDOFF_ON_PROVIDER_FAILURE=true
CONVERSATION_RETENTION_DAYS=0       # 0 = keep forever; purge with: python -m app.cli purge-conversations
RESOLVED_AUTO_CLOSE_DAYS=7          # close resolved chats after N days without a customer reply; 0 = never
MAINTENANCE_INTERVAL_SECONDS=3600   # how often the worker checks for resolved chats to close
CONVERSATION_REUSE_WINDOW_HOURS=24  # same opening question continues a recent open chat; 0 = always new

# --- Uploads / storage / ingestion --------------------------------------------
MAX_UPLOAD_SIZE=20971520            # bytes (20 MiB)
STORAGE_PROVIDER=local              # local | s3
STORAGE_LOCAL_PATH=./data/uploads
S3_BUCKET=
S3_PREFIX=documents/
INGESTION_WORKER_EMBEDDED=true      # compose runs a dedicated worker and sets this to false

# --- Rate limits --------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN=10/minute
RATE_LIMIT_CHAT=30/minute
RATE_LIMIT_UPLOAD=30/hour
RATE_LIMIT_ADMIN=300/minute

# --- Local development seed users (ignored in production) ---------------------
# Leave empty to use the documented development defaults.
SEED_ADMIN_PASSWORD=
SEED_AGENT_PASSWORD=
SEED_CUSTOMER_PASSWORD=
